generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contract {
  id             Int       @id @default(autoincrement())
  contractNumber String    @map("contract_number")
  customerName   String    @map("customer_name")
  kostenplaats   String?
  description    String?
  startDate      DateTime  @db.Date @map("start_date")
  endDate        DateTime? @db.Date @map("end_date")
  contractValue    Float?    @map("contract_value")
  m2               Float?    @map("m2")
  pricePerM2       Float?    @map("price_per_m2")
  priceIndex       Float?    @map("price_index")
  basePricePerM2   Float?    @map("base_price_per_m2")
  baseIndexYear    Int?      @map("base_index_year")
  indexSeries      String?   @map("index_series")
  contractType     String?   @map("contract_type")
  invoiceFrequency String?   @map("invoice_frequency")
  manager          String?   @map("manager")
  invoiceStartDate DateTime? @db.Date @map("invoice_start_date")
  invoiceEndDate   DateTime? @db.Date @map("invoice_end_date")
  debiteurnummer   String?   @map("debiteurnummer")
  kadastrale       String?   @map("kadastrale")
  grootboekNieuw   String?   @map("grootboek")
  grootboekOud     String?   @map("grootboek_oud")
  btwCode          String?   @map("btw_code")
  invoiceRef       String?   @map("invoice_ref")
  fixedPrice       Boolean   @default(false) @map("fixed_price")
  status           String    @default("draft")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  // Onroerende voorheffing (Vlaanderen); de tarieven staan op het contract zodat ze aanpasbaar zijn
  kadastraalInkomen       Float?  @map("kadastraal_inkomen")
  ovGemeente              String? @map("ov_gemeente")
  ovProvincie             String? @map("ov_provincie")
  ovOpcentiemenGemeente   Float?  @map("ov_opcentiemen_gemeente")
  ovOpcentiemenProvincie  Float?  @map("ov_opcentiemen_provincie")
  // OZB (Nederland): voorbeeldberekening om een ontvangen aanslag mee te controleren
  wozWaarde               Float?  @map("woz_waarde")
  ozbTarief               Float?  @map("ozb_tarief")
  contractNotes  ContractNote[]
  invoices       Invoice[]

  @@map("contracts")
}

// Facturen (demo): aangemaakt in CP-001, verzonden naar en geboekt in de Unit4-simulatie.
// type 'contract' volgt de frequentie; type 'belasting' volgt een ontvangen aanslag (OV of OZB) van een aanslagjaar.
model Invoice {
  id             Int       @id @default(autoincrement())
  contractId     Int       @map("contract_id")
  contract       Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type           String    @default("contract")
  taxType        String?   @map("tax_type")
  taxYear        Int?      @map("tax_year")
  taxReceivedAt  DateTime? @db.Date @map("tax_received_at")
  taxReference   String?   @map("tax_reference")
  // Correctie van een geboekte aanslag: creditfactuur (creditOfId) plus nieuwe factuur; het origineel wordt credited
  creditOfId     Int?      @map("credit_of_id")
  credited       Boolean   @default(false)
  runKey         String?   @map("run_key")
  customerReference String? @map("customer_reference")
  invoiceDate    DateTime? @db.Date @map("invoice_date")
  dueDate        DateTime? @db.Date @map("due_date")
  paidAt         DateTime? @map("paid_at")
  contractNumber String    @map("contract_number")
  debiteurnummer String?
  customerName   String    @map("customer_name")
  frequency      String
  periodLabel    String    @map("period_label")
  periodStart    DateTime  @db.Date @map("period_start")
  periodEnd      DateTime  @db.Date @map("period_end")
  lines          Json
  subtotal       Float
  vatAmount      Float     @map("vat_amount")
  total          Float
  // aangemaakt (concept in CP-001) → verzonden (naar Unit4) → geboekt → betaald (beide gemeld door Unit4)
  status         String    @default("aangemaakt")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  sentAt         DateTime? @map("sent_at")
  bookedAt       DateTime? @map("booked_at")
  bookedBy       String?   @map("booked_by")
  unit4Number    String?   @map("unit4_number")

  @@index([contractId])
  @@map("invoices")
}

// Notities met datum/tijd en auteur (de inlognaam); tekst niet wijzigbaar
model ContractNote {
  id         Int      @id @default(autoincrement())
  contractId Int      @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  text       String
  author     String
  createdAt  DateTime @default(now()) @map("created_at")
  // Optioneel toegewezen aan een team (zie src/lib/teams.js): dan is het een actie die afgerond kan worden
  team       String?
  doneAt     DateTime? @map("done_at")
  doneBy     String?   @map("done_by")

  @@index([contractId])
  @@map("contract_notes")
}

model BtwCode {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String
  percentage  Float?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("btw_codes")
}

model Customer {
  id                Int      @id @default(autoincrement())
  debiteurnummer    String   @unique @map("debiteurnummer")
  debiteurnummerOud String?  @map("debiteurnummer_oud")
  name              String
  address        String?
  city           String?
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

// Unit4-simulatie: een apart systeem met eigen gegevens. Kent alleen wat via de koppeling binnenkwam (payload);
// geen relatie met de tabellen van CP-001, net als in werkelijkheid.
model Unit4Invoice {
  id             Int       @id @default(autoincrement())
  externalId     String    @unique @map("external_id")
  cp001InvoiceId Int       @map("cp001_invoice_id")
  number         String?
  status         String    @default("ontvangen")
  payload        Json
  receivedAt     DateTime  @default(now()) @map("received_at")
  bookedAt       DateTime? @map("booked_at")
  bookedBy       String?   @map("booked_by")
  paidAt         DateTime? @map("paid_at")
  paidBy         String?   @map("paid_by")

  @@map("unit4_sales_invoices")
}

// Logboek van alle berichten tussen CP-001 en Unit4, in beide richtingen
model InterfaceMessage {
  id         Int      @id @default(autoincrement())
  invoiceId  Int?     @map("invoice_id")
  direction  String
  operation  String
  method     String
  endpoint   String
  payload    Json
  response   Json?
  httpStatus Int      @map("http_status")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("interface_messages")
}
